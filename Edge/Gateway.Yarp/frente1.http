# =============================================================================
# Frente 1 — Testes Funcionais e de Segurança — .NET Study Case
# Referência: Plano de Testes, cenários 1 a 6
# Cenários 7, 8 e 10: executados via curl e Wireshark (arquivos separados)
# Cenário 9: requer Direct access grants ON temporariamente
# =============================================================================

# =============================================================================
# BLOCO 0 — Tokens necessários (rodar antes dos cenários)
# =============================================================================

### [TOKEN] testuser (role: user)
POST {{realm}}
Content-Type: application/x-www-form-urlencoded

grant_type=password&client_id={{clientId}}&client_secret={{clientSecret}}&username=testuser&password={{testUserPassword}}

> {%
    client.global.set("testuserToken", response.body.access_token);
%}

### [TOKEN] adminuser (role: admin)
POST {{realm}}
Content-Type: application/x-www-form-urlencoded

grant_type=password&client_id={{clientId}}&client_secret={{clientSecret}}&username=adminuser&password={{adminUserPassword}}

> {%
    client.global.set("adminuserToken", response.body.access_token);
%}

### [TOKEN] microservice-client (role: service) — para cenário 6
POST {{realm}}
Content-Type: application/x-www-form-urlencoded

grant_type=client_credentials&client_id=microservice-client&client_secret={{microserviceClientSecret}}

> {%
    client.global.set("serviceToken", response.body.access_token);
%}


